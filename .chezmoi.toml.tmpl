sourceDir = {{ .chezmoi.sourceDir | quote }}
[data]
{{- if eq .chezmoi.os "darwin" }}
	defaultShell = "zsh"
{{ else }}
	defaultShell = "bash"
{{ end }}

[data.agents.claude]
	enabled = false
	models = {
		plan = "opus",
		execute = "sonnet",
		fast = "haiku"
	}
[data.agents.codex]
	enabled = false
	models = {
		plan = "gpt-5.6-sol",
		execute = "gpt-5.6-terra",
		fast = "gpt-5.6-luna"
	}

[data.agents.skills]
	dir = ".agents/skills"
	pocock.enabled = true
